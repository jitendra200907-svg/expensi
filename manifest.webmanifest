{
  "name": "Expensi - INR Expense Tracker",
  "short_name": "Expensi",
  "description": "Track expenses, budgets, and payment receipts in INR.",
  "start_url": "./main.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8f4",
  "theme_color": "#202522",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./main.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text"
    }
  }
}
